{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Phân tích hội tụ của Robust Risk-Aware Bandit\n",
    "Notebook này nạp dữ liệu từ các file `.npz` chuẩn hóa và vẽ đồ thị so sánh giữa các thuật toán."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import os\n",
    "import glob\n",
    "\n",
    "# 1. Cấu hình Filter (Khớp với run_robust_sweep.py)\n",
    "CONFIG = {\n",
    "    'data_type': 'robust_syn',\n",
    "    'agent_eval': 'local',\n",
    "    'oracle_eval': 'local',\n",
    "    'alpha': 0.05,\n",
    "    'beta': 0.1,\n",
    "    'layers': '10' # Hoặc '32-32' tùy cấu hình\n",
    "}\n",
    "\n",
    "n_list = [100, 500, 1000, 2000, 5000]\n",
    "\n",
    "def load_all_algos(n_list, config):\n",
    "    results = {} # {algo_name: {n: [metrics]}}\n",
    "    \n",
    "    # Tìm thư mục kết quả mới nhất\n",
    "    potential_dirs = glob.glob(f\"results/{config['data_type']}*\")\n",
    "    if not potential_dirs: \n",
    "        print(\"Không tìm thấy thư mục kết quả!\")\n",
    "        return {}\n",
    "    data_dir = sorted(potential_dirs, key=os.path.getmtime)[-1]\n",
    "    print(f\"Loading from: {data_dir}\")\n",
    "\n",
    "    for n in n_list:\n",
    "        # Pattern tìm file khớp với chuẩn hóa prefix mới\n",
    "        pattern = os.path.join(data_dir, f\"*_agent={config['agent_eval']}_oracle={config['oracle_eval']}_*alpha={config['alpha']}_beta={config['beta']}_n={n}_layers={config['layers']}*.npz\")\n",
    "        files = glob.glob(pattern)\n",
    "        \n",
    "        for f in files:\n",
    "            d = np.load(f, allow_pickle=True)\n",
    "            algo_names = d['algo_names']\n",
    "            \n",
    "            for i, name in enumerate(algo_names):\n",
    "                if name not in results: \n",
    "                    results[name] = {'n': [], 'subopt_mean': [], 'subopt_std': [], 'regret_mean': [], 'regret_std': []}\n",
    "                \n",
    "                name_key = name.replace(' ', '_')\n",
    "                r = d[f\"{name_key}_regrets\"]\n",
    "                c = d[f\"{name_key}_gt_cvars\"]\n",
    "                o_cvar = np.mean(d['all_oracle_cvars'])\n",
    "                sub = o_cvar - c\n",
    "                \n",
    "                results[name]['n'].append(n)\n",
    "                results[name]['regret_mean'].append(np.mean(r))\n",
    "                results[name]['regret_std'].append(np.std(r) / np.sqrt(len(r)))\n",
    "                results[name]['subopt_mean'].append(np.mean(sub))\n",
    "                results[name]['subopt_std'].append(np.std(sub) / np.sqrt(len(sub)))\n",
    "                \n",
    "    return results\n",
    "\n",
    "data = load_all_algos(n_list, CONFIG)\n",
    "print(f\"Đã nạp dữ liệu cho {len(data)} thuật toán: {list(data.keys())}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1. Suboptimality Gap Convergence\n",
    "Biểu đồ này cho thấy mức độ hội tụ rủi ro. Khoảng cách càng gần 0 nghĩa là Agent càng đạt tới mức an toàn của Oracle."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 6))\n",
    "colors = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728']\n",
    "\n",
    "for i, (name, res) in enumerate(data.items()):\n",
    "    # Sắp xếp theo n để vẽ đường thẳng\n",
    "    idxs = np.argsort(res['n'])\n",
    "    nx = np.array(res['n'])[idxs]\n",
    "    my = np.array(res['subopt_mean'])[idxs]\n",
    "    sy = np.array(res['subopt_std'])[idxs]\n",
    "    \n",
    "    plt.errorbar(nx, my, yerr=sy, fmt='-o', capsize=5, label=name, color=colors[i%len(colors)], markersize=8)\n",
    "\n",
    "plt.axhline(0, color='black', linestyle='--', alpha=0.6)\n",
    "plt.title(f\"Suboptimality Gap vs Sample Size (Alpha={CONFIG['alpha']}, Beta={CONFIG['beta']})\", fontsize=14)\n",
    "plt.xlabel(\"N (Training Samples)\", fontsize=12)\n",
    "plt.ylabel(\"Gap (Oracle CVaR - Agent CVaR)\", fontsize=12)\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 2. Regret Comparison\n",
    "So sánh hiệu năng trung bình giữa các thuật toán."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plt.figure(figsize=(10, 6))\n",
    "for i, (name, res) in enumerate(data.items()):\n",
    "    idxs = np.argsort(res['n'])\n",
    "    nx = np.array(res['n'])[idxs]\n",
    "    my = np.array(res['regret_mean'])[idxs]\n",
    "    sy = np.array(res['regret_std'])[idxs]\n",
    "    \n",
    "    plt.errorbar(nx, my, yerr=sy, fmt='-s', capsize=5, label=name, color=colors[i%len(colors)], markersize=8)\n",
    "\n",
    "plt.xscale('log')\n",
    "plt.yscale('log')\n",
    "plt.title(\"Regret vs Sample Size (Log-Log Scale)\", fontsize=14)\n",
    "plt.xlabel(\"N (Training Samples)\", fontsize=12)\n",
    "plt.ylabel(\"Expected Regret\", fontsize=12)\n",
    "plt.grid(True, which=\"both\", alpha=0.3)\n",
    "plt.legend()\n",
    "plt.show()"
   ]
  }\n",
 ],
